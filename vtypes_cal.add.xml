<?xml version="1.0" encoding="UTF-8"?>
<!--
Dhaka heterogeneous vehicle types for Bijoy Sarani.

Sources / assumptions (document these in the thesis):
- Driver behaviour sigma=0.3, tau=1.4: SUMO calibration for heterogeneous
  Bangladeshi traffic, Khulna CBD study (Transp. Res. Interdisc. Persp., 2024).
- CNG auto-rickshaw dimensions 2.6 x 1.3 m: standard Bajaj RE-type
  three-wheeler specifications; maxSpeed ~50 km/h reflects Dhaka speed
  governors on CNGs.
- Other dimensions: standard manufacturer specs; accelerations follow common
  values in the mixed-traffic microsimulation literature.
- Sublane attributes (minGapLat, latAlignment, lcPushy/lcAssertive) only take
  effect when sumo runs with |||lateral-resolution; they are ignored in
  lane-based runs, so one vtypes file serves both models.
- Classes present in the count data but excluded here: bicycle,
  cycle-rickshaw, pedestrian (non-motorized transport is banned on Bijoy
  Sarani VIP road; counts confirm: 9 rickshaws/h at peak vs 10,653 motorized).
-->
<additional>
    <vType id="heavy_truck" vClass="truck"      length="10.0" width="2.5" accel="1.0" decel="3.5" maxSpeed="16.7" sigma="0.3" tau="0.9" minGap="1.2" minGapLat="0.3" latAlignment="center"/>
    <vType id="med_truck"   vClass="truck"      length="7.5"  width="2.3" accel="1.3" decel="3.5" maxSpeed="16.7" sigma="0.3" tau="0.9" minGap="1.2" minGapLat="0.3" latAlignment="center"/>
    <vType id="small_truck" vClass="delivery"   length="6.0"  width="2.1" accel="1.6" decel="4.0" maxSpeed="19.4" sigma="0.3" tau="0.9" minGap="1.2" minGapLat="0.3" latAlignment="center"/>
    <vType id="large_bus"   vClass="bus"        length="12.0" width="2.5" accel="1.0" decel="3.5" maxSpeed="16.7" sigma="0.3" tau="0.9" minGap="1.2" minGapLat="0.3" latAlignment="center"/>
    <vType id="medium_bus"  vClass="bus"        length="9.0"  width="2.4" accel="1.2" decel="3.5" maxSpeed="16.7" sigma="0.3" tau="0.9" minGap="1.2" minGapLat="0.3" latAlignment="center"/>
    <vType id="micro_bus"   vClass="passenger"  length="5.0"  width="1.9" accel="1.8" decel="4.0" maxSpeed="22.2" sigma="0.3" tau="0.9" minGap="1.2" minGapLat="0.3" latAlignment="center"/>
    <vType id="utility"     vClass="passenger"  length="4.6"  width="1.8" accel="2.0" decel="4.5" maxSpeed="25.0" sigma="0.3" tau="0.9" minGap="1.2" minGapLat="0.3" latAlignment="center"/>
    <vType id="car"         vClass="passenger"  length="4.3"  width="1.8" accel="2.4" decel="4.5" maxSpeed="27.8" sigma="0.3" tau="0.9" minGap="1.2" minGapLat="0.3" latAlignment="center"/>
    <vType id="cng"         vClass="passenger"  length="2.6"  width="1.3" accel="1.4" decel="4.0" maxSpeed="13.9" sigma="0.3" tau="0.9" minGap="1.2" minGapLat="0.3" latAlignment="compact" lcPushy="0.5" lcAssertive="1.5"/>
    <vType id="motorcycle"  vClass="motorcycle" length="2.0"  width="0.8" accel="3.0" decel="5.0" maxSpeed="22.2" sigma="0.3" tau="0.9" minGap="1.2" minGapLat="0.3" latAlignment="compact" lcPushy="0.8" lcAssertive="2.0"/>
</additional>
